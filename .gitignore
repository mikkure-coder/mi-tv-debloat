# Логи работы скриптов — локальная история, в репо не нужны
logs/
# Бэкапы списков пакетов, снятые с конкретного ТВ — у каждого свои
backup/
# Скачанные APK с FLauncher — качаются скриптом, зависят от версии
*.apk
# Временные файлы редакторов
*.swp
*.bak
.DS_Store
# Локальный файл с IP телевизора, его пишет 00-prepare.sh — в репо нельзя
.tv-host
# Лаунчер «Витрина»: сборка и локальные пути SDK
launcher/.gradle/
launcher/app/build/
launcher/build/
launcher/local.properties
# Настройки «Витрины» — личные (город), в репо нельзя
vitrina.json
